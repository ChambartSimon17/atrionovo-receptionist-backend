// ======================================================
// GENERATOR
// ======================================================

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// DATASOURCE
// ======================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

// ------------------------------------------------------
// Reservation lifecycle
// ------------------------------------------------------
// Defines the current state of a reservation.
//
// CONFIRMED - Reservation is accepted.
// CANCELLED - Reservation was cancelled.
// COMPLETED - Guests have finished dining.
// NO_SHOW   - Guests never arrived.
// ------------------------------------------------------

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ------------------------------------------------------
// Days of the week
// ------------------------------------------------------
// Used for recurring weekly opening hours.
//
// Example:
// MONDAY
// 17:00 → 22:00
// ------------------------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

// ------------------------------------------------------
// Table shapes
// ------------------------------------------------------

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
}

// ======================================================
// USER DOMAIN
// ======================================================

// ------------------------------------------------------
// User
// ------------------------------------------------------
// Represents a user account for an AtrioNovo restaurant.
//

model User {
  id String @id @default(cuid())

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  role UserRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

// ======================================================
// RESTAURANT DOMAIN
// ======================================================

// ------------------------------------------------------
// Restaurant
// ------------------------------------------------------
// Represents a restaurant using the AtrioNovo platform.
//
// Responsibilities
// - Store restaurant information
// - Define restaurant configuration
// - Own opening hours
// - Own reservations
//
// Future
// - Tables
// - Arrival slot limits
// - Staff
// - AI assistant configuration
// - Subscription
// ------------------------------------------------------

model Restaurant {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Basic Information
  // -------------------------

  name        String
  slug        String @unique
  countryCode String

  // -------------------------
  // Restaurant Configuration
  // -------------------------

  maxCapacity Int @default(50)

  defaultReservationDurationMinutes Int @default(120)

  maxReservationSize Int @default(8)

  // Reservation arrival interval (minutes).
  //
  // Reservations may only start at
  // multiples of this interval.

  arrivalIntervalMinutes Int @default(15)

  timezone String @default("Europe/Brussels")
  language String @default("nl")

  // -------------------------
  // Relationships
  // -------------------------

  openingHours       OpeningHour[]
  specialOpeningDays SpecialOpeningDay[]
  reservations       Reservation[]
  customers          Customer[]
  users              User[]
  tables             Table[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Restaurant Relationship
  // -------------------------

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // -------------------------
  // Customer Information
  // -------------------------

  firstName String
  lastName  String

  phoneNumber String
  email       String?

  // -------------------------
  // Customer Details
  // -------------------------

  notes String?

  isVip Boolean @default(false)

  // -------------------------
  // Metadata
  // -------------------------

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@unique([restaurantId, phoneNumber], map: "uq_customer_restaurant_phone")
  @@index([restaurantId, email], map: "idx_customer_restaurant_email")
  @@index([restaurantId, lastName], map: "idx_customer_restaurant_last_name")
}

// ======================================================
// TABLE DOMAIN
// ======================================================

// ------------------------------------------------------
// Table
// ------------------------------------------------------
// Represents a physical restaurant table.
//
// The table contains both:
//
// 1. Reservation logic
//    - capacity
//    - active/inactive
//
// 2. Floor plan information
//    - position
//    - size
//    - shape
//    - rotation
//
// The floor plan values allow the frontend to
// visually position the table inside the restaurant.
// ------------------------------------------------------

model Table {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Restaurant Relationship
  // -------------------------

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // -------------------------
  // Table Information
  // -------------------------

  name String

  capacity Int

  shape TableShape @default(RECTANGLE)

  // -------------------------
  // Floor Plan
  // -------------------------
  //
  // Coordinates are stored relative
  // to the restaurant floor plan.

  x Float @default(0)
  y Float @default(0)

  width  Float @default(100)
  height Float @default(60)

  rotation Float @default(0)

  // -------------------------
  // Status
  // -------------------------

  // Allows a restaurant to temporarily
  // disable a table without deleting it.

  isActive Boolean @default(true)

  // -------------------------
  // Relationships
  // -------------------------

  reservations ReservationTable[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([restaurantId])
}

// ------------------------------------------------------
// OpeningHour
// ------------------------------------------------------
// Represents one opening period for a restaurant.
//
// Examples
//
// Monday
// 17:00 → 22:00
//
// Sunday
// 12:00 → 15:00
// 17:00 → 22:00
//
// A restaurant may have multiple opening
// periods on the same day.
// ------------------------------------------------------

model OpeningHour {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Restaurant Relationship
  // -------------------------

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // -------------------------
  // Opening Period
  // -------------------------

  dayOfWeek DayOfWeek

  // Minutes after midnight.
  //
  // Examples
  // 17:00 → 1020
  // 22:00 → 1320

  opensAtMinutes  Int
  closesAtMinutes Int

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([restaurantId, dayOfWeek], map: "idx_opening_hour_restaurant_day")
}

// ------------------------------------------------------
// SpecialOpeningDay
// ------------------------------------------------------
// Represents an exception to the restaurant's
// normal weekly opening schedule.
//
// Examples
//
// 2026-12-24
// - 12:00 → 15:00
// - 18:00 → 22:00
//
// 2026-12-25
// Closed
// ------------------------------------------------------

model SpecialOpeningDay {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Restaurant Relationship
  // -------------------------

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // -------------------------
  // Date
  // -------------------------

  date DateTime

  // -------------------------
  // Configuration
  // -------------------------

  isClosed Boolean @default(false)

  // -------------------------
  // Relationships
  // -------------------------

  openingPeriods SpecialOpeningPeriod[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@unique([restaurantId, date])
}

// ------------------------------------------------------
// SpecialOpeningPeriod
// ------------------------------------------------------
// Represents one opening period belonging
// to a special opening day.
//
// Example
//
// Christmas Eve
//
// 12:00 → 15:00
// 18:00 → 22:00
// ------------------------------------------------------

model SpecialOpeningPeriod {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Relationship
  // -------------------------

  specialOpeningDayId String

  specialOpeningDay SpecialOpeningDay @relation(fields: [specialOpeningDayId], references: [id], onDelete: Cascade)

  // -------------------------
  // Opening Period
  // -------------------------

  opensAtMinutes  Int
  closesAtMinutes Int

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([specialOpeningDayId])
}

// ======================================================
// RESERVATION DOMAIN
// ======================================================

// ------------------------------------------------------
// Reservation
// ------------------------------------------------------
// Represents one reservation made by a customer.
//
// Business Rules
// - Always belongs to one restaurant
// - Has a fixed start and end time
// - Status defaults to CONFIRMED
// ------------------------------------------------------

model Reservation {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Restaurant Relationship
  // -------------------------

  restaurantId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // -------------------------
  // Customer Relationship
  // -------------------------

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // -------------------------
  // Customer Snapshot
  // -------------------------

  firstName String
  lastName  String

  phoneNumber String
  email       String?

  // -------------------------
  // Reservation Details
  // -------------------------

  guestCount Int

  startTime DateTime
  endTime   DateTime

  status ReservationStatus @default(CONFIRMED)

  notes String?

  // -------------------------
  // Table Assignment
  // -------------------------

  tables ReservationTable[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([restaurantId], map: "idx_reservation_restaurant")
  @@index([customerId], map: "idx_reservation_customer")
  @@index([startTime], map: "idx_reservation_start_time")
  @@index([endTime], map: "idx_reservation_end_time")
  @@index([restaurantId, startTime], map: "idx_reservation_restaurant_start")
}

// ======================================================
// RESERVATION ↔ TABLE
// ======================================================

// ------------------------------------------------------
// ReservationTable
// ------------------------------------------------------
// Connects reservations with one or more tables.
//
// This allows:
//
// Reservation → Table 1
//
// but also:
//
// Reservation → Table 1 + Table 2
//
// which is necessary for larger groups.
// ------------------------------------------------------

model ReservationTable {
  reservationId String
  tableId       String

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Prevent the same table from being
  // assigned twice to the same reservation.

  @@id([reservationId, tableId])
  @@index([tableId])
}
