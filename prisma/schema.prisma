// ======================================================
// GENERATOR
// ======================================================

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// DATASOURCE
// ======================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

// ------------------------------------------------------
// Reservation lifecycle
// ------------------------------------------------------
// Defines the current state of a reservation.
//
// CONFIRMED - Reservation is accepted.
// CANCELLED - Reservation was cancelled.
// COMPLETED - Guests have finished dining.
// NO_SHOW   - Guests never arrived.
// ------------------------------------------------------

enum ReservationStatus {
  // Reservation is accepted and the guests
  // have not yet been marked as seated.
  CONFIRMED

  // Guests have arrived and are currently
  // seated at their assigned table(s).
  SEATED

  // Guests have finished dining.
  COMPLETED

  // Reservation was cancelled.
  CANCELLED

  // Guests never arrived.
  NO_SHOW
}

// ------------------------------------------------------
// Days of the week
// ------------------------------------------------------
// Used for recurring weekly opening hours.
//
// Example:
// MONDAY
// 17:00 → 22:00
// ------------------------------------------------------

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

// ------------------------------------------------------
// Table shapes
// ------------------------------------------------------

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
}

// ------------------------------------------------------
// Business types
// ------------------------------------------------------
// A business is exactly one type and the type never
// changes after registration. The type decides which
// dashboard the app shows and which features exist.
//
// RESTAURANT - Tables, party size, dining reservations.
// MASSAGE    - Massage services, therapists, treatment rooms.
// ------------------------------------------------------

enum BusinessType {
  RESTAURANT
  MASSAGE
}

// ------------------------------------------------------
// Appointment lifecycle (massage)
// ------------------------------------------------------
//
// CONFIRMED - Appointment is accepted.
// COMPLETED - The massage took place.
// CANCELLED - Appointment was cancelled.
// NO_SHOW   - The customer never arrived.
//
// Only CONFIRMED and COMPLETED appointments occupy their
// therapist and room.
// ------------------------------------------------------

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ======================================================
// USER DOMAIN
// ======================================================

// ------------------------------------------------------
// User
// ------------------------------------------------------
// Represents a user account for an AtrioNovo business.
//

model User {
  id String @id @default(cuid())

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  role UserRole @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
}

// ======================================================
// BUSINESS DOMAIN
// ======================================================

// ------------------------------------------------------
// Business
// ------------------------------------------------------
// Represents a business using the AtrioNovo platform
// (currently always a restaurant).
//
// Responsibilities
// - Store business information
// - Define business configuration
// - Own opening hours
// - Own reservations
//
// Future
// - Tables
// - Arrival slot limits
// - Staff
// - AI assistant configuration
// - Subscription
// ------------------------------------------------------

model Business {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Basic Information
  // -------------------------

  name        String
  slug        String @unique
  countryCode String

  // Fixed at registration. Existing rows are restaurants.
  businessType BusinessType @default(RESTAURANT)

  // -------------------------
  // Business Configuration
  // -------------------------

  voiceAgentEnabled Boolean @default(true)

  maxCapacity Int @default(50)

  defaultReservationDurationMinutes Int @default(120)

  maxReservationSize Int @default(8)

  // Reservation arrival interval (minutes).
  //
  // Reservations may only start at
  // multiples of this interval.

  arrivalIntervalMinutes Int @default(15)

  // MASSAGE businesses: minutes blocked for the therapist
  // and the room after every appointment (cleaning, rest).

  appointmentBufferMinutes Int @default(0)

  timezone String @default("Europe/Brussels")
  language String @default("nl")

  // -------------------------
  // Relationships
  // -------------------------

  openingHours       OpeningHour[]
  specialOpeningDays SpecialOpeningDay[]
  reservations       Reservation[]
  customers          Customer[]
  users              User[]
  tables             Table[]
  massageServices    MassageService[]
  therapists         Therapist[]
  treatmentRooms     TreatmentRoom[]
  appointments       Appointment[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Mapping
  // -------------------------
  //
  // The model is called Business, but the physical table keeps
  // its original name. Together with the @map("restaurantId")
  // columns on the related models this makes the rename a
  // code-only change: no migration and no data movement.

  @@map("Restaurant")
}

model Customer {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Customer Information
  // -------------------------

  firstName String
  lastName  String

  phoneNumber String
  email       String?

  // -------------------------
  // Customer Details
  // -------------------------

  notes String?

  isVip Boolean @default(false)

  // -------------------------
  // Metadata
  // -------------------------

  reservations Reservation[]
  appointments  Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@unique([businessId, phoneNumber], map: "uq_customer_restaurant_phone")
  @@index([businessId, email], map: "idx_customer_restaurant_email")
  @@index([businessId, lastName], map: "idx_customer_restaurant_last_name")
}

// ======================================================
// TABLE DOMAIN
// ======================================================

// ------------------------------------------------------
// Table
// ------------------------------------------------------
// Represents a physical restaurant table.
//
// The table contains both:
//
// 1. Reservation logic
//    - capacity
//    - active/inactive
//
// 2. Floor plan information
//    - position
//    - size
//    - shape
//    - rotation
//
// The floor plan values allow the frontend to
// visually position the table inside the restaurant.
// ------------------------------------------------------

model Table {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Table Information
  // -------------------------

  name String

  capacity Int

  shape TableShape @default(RECTANGLE)

  // -------------------------
  // Floor Plan
  // -------------------------
  //
  // Coordinates are stored relative
  // to the restaurant floor plan.

  x Float @default(0)
  y Float @default(0)

  width  Float @default(100)
  height Float @default(60)

  rotation Float @default(0)

  // -------------------------
  // Status
  // -------------------------

  // Allows a restaurant to temporarily
  // disable a table without deleting it.

  isActive Boolean @default(true)

  // -------------------------
  // Relationships
  // -------------------------

  reservations ReservationTable[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([businessId])
}

// ------------------------------------------------------
// OpeningHour
// ------------------------------------------------------
// Represents one opening period for a business.
//
// Examples
//
// Monday
// 17:00 → 22:00
//
// Sunday
// 12:00 → 15:00
// 17:00 → 22:00
//
// A business may have multiple opening
// periods on the same day.
// ------------------------------------------------------

model OpeningHour {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Opening Period
  // -------------------------

  dayOfWeek DayOfWeek

  // Minutes after midnight.
  //
  // Examples
  // 17:00 → 1020
  // 22:00 → 1320

  opensAtMinutes  Int
  closesAtMinutes Int

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([businessId, dayOfWeek], map: "idx_opening_hour_restaurant_day")
}

// ------------------------------------------------------
// SpecialOpeningDay
// ------------------------------------------------------
// Represents an exception to the business's
// normal weekly opening schedule.
//
// Examples
//
// 2026-12-24
// - 12:00 → 15:00
// - 18:00 → 22:00
//
// 2026-12-25
// Closed
// ------------------------------------------------------

model SpecialOpeningDay {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Date
  // -------------------------

  date DateTime

  // -------------------------
  // Configuration
  // -------------------------

  isClosed Boolean @default(false)

  // -------------------------
  // Relationships
  // -------------------------

  openingPeriods SpecialOpeningPeriod[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@unique([businessId, date])
}

// ------------------------------------------------------
// SpecialOpeningPeriod
// ------------------------------------------------------
// Represents one opening period belonging
// to a special opening day.
//
// Example
//
// Christmas Eve
//
// 12:00 → 15:00
// 18:00 → 22:00
// ------------------------------------------------------

model SpecialOpeningPeriod {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Relationship
  // -------------------------

  specialOpeningDayId String

  specialOpeningDay SpecialOpeningDay @relation(fields: [specialOpeningDayId], references: [id], onDelete: Cascade)

  // -------------------------
  // Opening Period
  // -------------------------

  opensAtMinutes  Int
  closesAtMinutes Int

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([specialOpeningDayId])
}

// ======================================================
// RESERVATION DOMAIN
// ======================================================

// ------------------------------------------------------
// Reservation
// ------------------------------------------------------
// Represents one reservation made by a customer.
//
// Business Rules
// - Always belongs to one business
// - Has a fixed start and end time
// - Status defaults to CONFIRMED
// ------------------------------------------------------

model Reservation {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String @map("restaurantId")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Customer Relationship
  // -------------------------

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // -------------------------
  // Customer Snapshot
  // -------------------------

  firstName String
  lastName  String

  phoneNumber String
  email       String?

  // -------------------------
  // Reservation Details
  // -------------------------

  guestCount Int

  startTime DateTime
  endTime   DateTime

  status ReservationStatus @default(CONFIRMED)

  notes String?

  // -------------------------
  // Table Assignment
  // -------------------------

  tables ReservationTable[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([businessId], map: "idx_reservation_restaurant")
  @@index([customerId], map: "idx_reservation_customer")
  @@index([startTime], map: "idx_reservation_start_time")
  @@index([endTime], map: "idx_reservation_end_time")
  @@index([businessId, startTime], map: "idx_reservation_restaurant_start")
}

// ======================================================
// RESERVATION ↔ TABLE
// ======================================================

// ------------------------------------------------------
// ReservationTable
// ------------------------------------------------------
// Connects reservations with one or more tables.
//
// This allows:
//
// Reservation → Table 1
//
// but also:
//
// Reservation → Table 1 + Table 2
//
// which is necessary for larger groups.
// ------------------------------------------------------

model ReservationTable {
  reservationId String
  tableId       String

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Prevent the same table from being
  // assigned twice to the same reservation.

  @@id([reservationId, tableId])
  @@index([tableId])
}

// ======================================================
// MASSAGE DOMAIN
// ======================================================

// ------------------------------------------------------
// MassageService
// ------------------------------------------------------
// A massage a customer can book at a MASSAGE business,
// for example "Relaxation massage, 60 minutes, 55.00".
//
// Prices are stored in cents to avoid rounding errors.
// Services are deactivated instead of deleted, so
// existing appointments keep pointing to them.
// ------------------------------------------------------

model MassageService {
  // -------------------------
  // Primary Key
  // -------------------------

  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Service Information
  // -------------------------

  name        String
  description String?

  durationMinutes Int

  priceCents Int
  currency   String @default("EUR")

  isActive Boolean @default(true)

  // -------------------------
  // Who and where
  // -------------------------
  //
  // Which therapists can perform this massage and in
  // which treatment rooms it can take place.

  therapistLinks TherapistMassageService[]
  roomLinks      RoomMassageService[]

  appointments Appointment[]

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@unique([businessId, name])
}

// ------------------------------------------------------
// Therapist
// ------------------------------------------------------
// A massage therapist working for a MASSAGE business.
//
// Customers cannot choose a therapist. The system picks
// a free therapist who can perform the chosen massage.
//
// Deactivated instead of deleted, so that existing
// appointments keep their therapist.
// ------------------------------------------------------

model Therapist {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  // Massages this therapist can perform.
  services TherapistMassageService[]

  // Weekly working hours (several periods per day allowed).
  workingHours TherapistWorkingHour[]

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
}

// Which massages a therapist can perform.

model TherapistMassageService {
  therapistId      String
  massageServiceId String

  therapist      Therapist      @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  massageService MassageService @relation(fields: [massageServiceId], references: [id], onDelete: Cascade)

  @@id([therapistId, massageServiceId])
  @@index([massageServiceId])
}

// ------------------------------------------------------
// TherapistWorkingHour
// ------------------------------------------------------
// One working period of a therapist on a weekday.
// Times are minutes after midnight (09:00 -> 540), like
// OpeningHour. Periods of one day may not overlap.
// ------------------------------------------------------

model TherapistWorkingHour {
  id String @id @default(cuid())

  therapistId String

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek

  startMinutes Int
  endMinutes   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([therapistId, dayOfWeek])
}

// ------------------------------------------------------
// TreatmentRoom
// ------------------------------------------------------
// A room where massages take place. Each room lists the
// massages that can be performed in it.
//
// Two appointments can only run at the same time when
// they are in different rooms.
// ------------------------------------------------------

model TreatmentRoom {
  id String @id @default(cuid())

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  // Massages that can be performed in this room.
  services RoomMassageService[]

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
}

// Which massages can be performed in a room.

model RoomMassageService {
  roomId           String
  massageServiceId String

  room           TreatmentRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  massageService MassageService @relation(fields: [massageServiceId], references: [id], onDelete: Cascade)

  @@id([roomId, massageServiceId])
  @@index([massageServiceId])
}

// ------------------------------------------------------
// Appointment
// ------------------------------------------------------
// A booked massage at a MASSAGE business.
//
// The system assigns a therapist and a room when the
// appointment is made; customers do not choose them.
//
// Customer details, massage name, duration and price are
// copied onto the appointment (snapshot), so later changes
// to the customer or the massage do not alter history.
//
// Therapists, rooms and massages cannot be deleted while
// appointments use them (they are deactivated instead).
// ------------------------------------------------------

model Appointment {
  id String @id @default(cuid())

  // -------------------------
  // Business Relationship
  // -------------------------

  businessId String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // -------------------------
  // Customer
  // -------------------------

  customerId String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  firstName String
  lastName  String

  phoneNumber String
  email       String?

  // -------------------------
  // Massage (snapshot)
  // -------------------------

  massageServiceId String

  massageService MassageService @relation(fields: [massageServiceId], references: [id], onDelete: Restrict)

  serviceName     String
  durationMinutes Int
  priceCents      Int

  // -------------------------
  // Assigned resources
  // -------------------------

  therapistId String

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  roomId String

  room TreatmentRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  // -------------------------
  // Time and status
  // -------------------------

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(CONFIRMED)

  notes String?

  // -------------------------
  // Metadata
  // -------------------------

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -------------------------
  // Database Indexes
  // -------------------------

  @@index([businessId, startTime])
  @@index([therapistId, startTime])
  @@index([roomId, startTime])
  @@index([customerId])
  @@index([massageServiceId])
}
