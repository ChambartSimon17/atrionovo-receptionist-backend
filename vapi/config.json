{
  "_comment": "Shared Vapi settings for the template assistants. Read by the backend (transcriber override per business) and by `npm run vapi:sync`. Taken from the massage assistant 'Massage Business v.0.1.0' (2026-11-22), without the business-specific keyterms: those live per business in Business.transcriberKeyterms.",
  "backendUrl": "https://atrionovo-receptionist-backend.onrender.com",
  "timeouts": {
    "toolSeconds": 15,
    "callEventsSeconds": 20,
    "assistantRequestSeconds": 5
  },
  "assistantDefaults": {
    "voice": {
      "provider": "11labs",
      "model": "eleven_v3_conversational",
      "voiceId": "ANHrhmaFeVN0QJaa0PhL",
      "speed": 1.2
    },
    "model": {
      "provider": "openai",
      "model": "gpt-4.1"
    },
    "transcriber": {
      "provider": "deepgram",
      "model": "nova-3",
      "language": "nl-BE",
      "numerals": true,
      "confidenceThreshold": 0.1,
      "fallbackPlan": {
        "transcribers": [
          {
            "provider": "deepgram",
            "model": "flux-general-en",
            "language": "en"
          }
        ]
      }
    },
    "firstMessage": "",
    "firstMessageMode": "assistant-speaks-first-with-model-generated-message",
    "firstMessageInterruptionsEnabled": false,
    "voicemailMessage": "Gelieve later terug te bellen.",
    "endCallMessage": "Tot ziens.",
    "backgroundDenoisingEnabled": false,
    "startSpeakingPlan": {
      "waitSeconds": 0.4,
      "smartEndpointingEnabled": false,
      "transcriptionEndpointingPlan": {
        "onPunctuationSeconds": 0.1,
        "onNoPunctuationSeconds": 0.8,
        "onNumberSeconds": 0.5
      }
    },
    "analysisPlan": {
      "summaryPlan": {
        "enabled": false
      },
      "successEvaluationPlan": {
        "enabled": false
      }
    },
    "serverMessages": [
      "end-of-call-report"
    ],
    "_comment_timing": "Endpointing, transcriber threshold, denoising and idle messages as on the In A Sense assistant (2026-11-25): it answers faster and asks again after silence.",
    "messagePlan": {
      "idleMessages": [
        "Sorry, ik heb u niet goed verstaan. Kunt u dat even herhalen?"
      ],
      "idleTimeoutSeconds": 7,
      "idleMessageMaxSpokenCount": 2,
      "idleMessageResetCountOnUserSpeechEnabled": true
    }
  },
  "assistants": {
    "RESTAURANT": {
      "name": "AtrioNovo Restaurant (sjabloon)",
      "prompt": "vapi/prompts/restaurant.nl.md",
      "envVar": "VAPI_ASSISTANT_RESTAURANT",
      "tools": [
        "getCallerProfile",
        "checkAvailability",
        "findAvailability",
        "createReservation",
        "updateReservation",
        "cancelReservation"
      ],
      "existingToolIds": {
        "_comment": "Vapi built-in end call tool (says the goodbye). No SMS tool: the backend sends the confirmation SMS after the call.",
        "end_call_tool": "13020185-9321-4a27-8be5-39ea5a1d2232"
      }
    },
    "MASSAGE": {
      "name": "AtrioNovo Massage (sjabloon)",
      "prompt": "vapi/prompts/massage.nl.md",
      "envVar": "VAPI_ASSISTANT_MASSAGE",
      "tools": [
        "Massage_getCallerProfile",
        "Massage_getServices",
        "Massage_checkAvailability",
        "Massage_findAvailability",
        "Massage_requestCallback",
        "Massage_createAppointment",
        "Massage_rescheduleAppointment",
        "Massage_cancelAppointment"
      ],
      "existingToolIds": {
        "end_call_tool": "13020185-9321-4a27-8be5-39ea5a1d2232",
        "_comment": "Vapi built-in end call tool (says the goodbye). No SMS tool: the backend sends the confirmation SMS after the call."
      }
    }
  }
}
